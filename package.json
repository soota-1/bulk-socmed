{
  "name": "bulk-socmed",
  "version": "0.0.1",
  "private": true,
  "description": "Penjadwal video pendek otomatis ke YouTube Shorts, Instagram Reels, dan TikTok",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "sync:env": "node scripts/sync-env.js",
    "dev:web": "node scripts/sync-env.js && pnpm --filter web dev",
    "dev:worker": "pnpm --filter worker dev",
    "check:env": "pnpm --filter worker exec tsx ../../scripts/doctor.ts",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r exec -- rimraf dist .next *.tsbuildinfo"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "rimraf": "^5.0.0",
    "typescript": "^5.6.0"
  }
}
