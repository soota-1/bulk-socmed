# =============================================================================
# Penjadwal Video Pendek - Environment Variables
# Salin ke .env (Vercel) dan .env (Worker di laptop)
# JANGAN komit .env ke repositori!
# =============================================================================

# --- Supabase (Publik - aman di browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- Supabase (Server-side only - JANGAN kirim ke browser) ---
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Enkripsi Token OAuth & API Key (32 bytes hex, server-side only) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENC_KEY=<64-char-hex-string>

# --- OAuth Google (YouTube Data API v3) ---
GOOGLE_CLIENT_ID=<project>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Harus didaftarkan di Google Cloud Console:
# Authorized redirect URIs: https://<nama-app>.vercel.app/api/oauth/youtube/callback

# --- OAuth Meta (Instagram Graph API) ---
META_APP_ID=<numeric-app-id>
META_APP_SECRET=<hex-string>

# Harus didaftarkan di Meta for Developers:
# Valid OAuth redirect URIs: https://<nama-app>.vercel.app/api/oauth/instagram/callback

# --- OAuth TikTok (TikTok Content Posting API v2) ---
TIKTOK_CLIENT_KEY=<client-key>
TIKTOK_CLIENT_SECRET=<client-secret>
# Mode upload TikTok: "inbox" (kirim ke Draft/Kotak Masuk TikTok, tidak butuh audit) atau "direct" (posting langsung, butuh audit TikTok)
# TIKTOK_UPLOAD_MODE=inbox

# Harus didaftarkan di TikTok for Developers (Login Kit & Content Posting API):
# Redirect URI: https://<nama-app>.vercel.app/api/oauth/tiktok/callback
# (atau http://localhost:3000/api/oauth/tiktok/callback saat pengujian lokal)

# --- Aplikasi Web ---
# URL produksi aplikasi (dipakai untuk CSRF origin check dan OAuth redirect)
NEXT_PUBLIC_APP_URL=https://<nama-app>.vercel.app

# --- Worker (hanya di laptop, tidak di Vercel) ---
# ID unik untuk worker instance ini (mis. "laptop-01")
WORKER_ID=laptop-01
# UUID pemilik dari Supabase Auth (users.id)
OWNER_ID=<uuid>


# --- Cloudflare R2 Object Storage (Free 10 GB/bln, Zero Egress, Max 5 TB/file) ---
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET_NAME=bulk-socmed-media
# Opsional: isi jika menggunakan custom domain / r2.dev public bucket URL
# R2_PUBLIC_DOMAIN=https://media.domainanda.com
